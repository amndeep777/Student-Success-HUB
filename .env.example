# Server Environment & Port
# In production, set to production (cloud hosts often inject PORT automatically)
NODE_ENV=production
PORT=4000

# MongoDB Database URI (e.g. MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/successhub?retryWrites=true&w=majority

# CORS Configuration
# Set to your frontend domain in production (e.g. https://successhub.onrender.com or * for all)
CORS_ORIGIN=*

# Razorpay Payment Gateway (Optional in demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
